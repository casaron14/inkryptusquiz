{
    "version": 2,
    "builds": [
        { "src": "api/*.js", "use": "@vercel/node" },
        { "src": "*.html", "use": "@vercel/static" },
        { "src": "*.css", "use": "@vercel/static" },
        { "src": "data/*.json", "use": "@vercel/static" }
    ],
    "routes": [
        { "src": "/api/([a-zA-Z0-9_-]+)", "dest": "/api/$1.js" },
        { "src": "/", "dest": "/index.html" },
        { "handle": "filesystem" }
    ]
}
